<Window x:Class="WpfDockProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="https://github.com/Dirkster99/AvalonDock"
        Title="WPF AvalonDock Example" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="Controls">
                <MenuItem Name="ToolboxMenuItem" Header="Toolbox" IsCheckable="True" IsChecked="True" 
                         Click="ToggleDockableControl_Click"/>
                <MenuItem Name="PropertiesMenuItem" Header="Properties" IsCheckable="True" IsChecked="True" 
                         Click="ToggleDockableControl_Click"/>
                <MenuItem Name="SolutionMenuItem" Header="Solution Explorer" IsCheckable="True" IsChecked="True" 
                         Click="ToggleDockableControl_Click"/>
                <MenuItem Name="OutputMenuItem" Header="Output" IsCheckable="True" IsChecked="True" 
                         Click="ToggleDockableControl_Click"/>
            </MenuItem>
        </Menu>
        
        <!-- AvalonDock Manager -->
        <dock:DockingManager Grid.Row="1" Name="dockingManager">
            
            <!-- Left Anchorable Pane -->
            <dock:LayoutRoot>
                <dock:LayoutPanel Orientation="Horizontal">
                    
                    <!-- Left Side -->
                    <dock:LayoutAnchorablePane DockWidth="200">
                        <dock:LayoutAnchorable ContentId="toolbox" Title="Toolbox" CanHide="True" CanClose="False">
                            <Grid Background="LightBlue">
                                <ListBox Margin="5">
                                    <ListBoxItem>Button</ListBoxItem>
                                    <ListBoxItem>TextBox</ListBoxItem>
                                    <ListBoxItem>Label</ListBoxItem>
                                    <ListBoxItem>ComboBox</ListBoxItem>
                                    <ListBoxItem>CheckBox</ListBoxItem>
                                </ListBox>
                            </Grid>
                        </dock:LayoutAnchorable>
                    </dock:LayoutAnchorablePane>
                    
                    <!-- Center and Right -->
                    <dock:LayoutPanel Orientation="Vertical">
                        
                        <!-- Top Row -->
                        <dock:LayoutPanel Orientation="Horizontal">
                            
                            <!-- Center Document Area -->
                            <dock:LayoutDocumentPane>
                                <dock:LayoutDocument ContentId="main" Title="Main Document" CanClose="False">
                                    <Grid Background="White">
                                        <TextBlock Text="AvalonDock Main Content Area" 
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                 FontSize="24" FontWeight="Bold" Foreground="Gray"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20">
                                            <TextBlock Text="AvalonDock 기능:" FontWeight="Bold" Margin="0,0,0,10"/>
                                            <TextBlock Text="• 패널을 드래그해서 위치를 변경할 수 있습니다" Margin="0,2"/>
                                            <TextBlock Text="• 패널을 다른 패널과 탭으로 결합할 수 있습니다" Margin="0,2"/>
                                            <TextBlock Text="• 패널을 별도 창으로 분리할 수 있습니다" Margin="0,2"/>
                                            <TextBlock Text="• 자동으로 도킹 위치를 표시해줍니다" Margin="0,2" Foreground="Red" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>
                                </dock:LayoutDocument>
                            </dock:LayoutDocumentPane>
                            
                            <!-- Right Side -->
                            <dock:LayoutAnchorablePane DockWidth="200">
                                <dock:LayoutAnchorable ContentId="properties" Title="Properties" CanHide="True" CanClose="False">
                                    <Grid Background="LightGreen">
                                        <StackPanel Margin="5">
                                            <TextBlock Text="Name:" FontWeight="Bold"/>
                                            <TextBox Text="Control1" Margin="0,2,0,5"/>
                                            <TextBlock Text="Width:" FontWeight="Bold"/>
                                            <TextBox Text="200" Margin="0,2,0,5"/>
                                            <TextBlock Text="Height:" FontWeight="Bold"/>
                                            <TextBox Text="100" Margin="0,2,0,5"/>
                                        </StackPanel>
                                    </Grid>
                                </dock:LayoutAnchorable>
                            </dock:LayoutAnchorablePane>
                            
                        </dock:LayoutPanel>
                        
                        <!-- Bottom Row -->
                        <dock:LayoutAnchorablePane DockHeight="150">
                            <dock:LayoutAnchorable ContentId="solution" Title="Solution Explorer" CanHide="True" CanClose="False">
                                <Grid Background="LightYellow">
                                    <TreeView Margin="5">
                                        <TreeViewItem Header="WpfDockProject" IsExpanded="True">
                                            <TreeViewItem Header="Properties"/>
                                            <TreeViewItem Header="References"/>
                                            <TreeViewItem Header="MainWindow.xaml"/>
                                            <TreeViewItem Header="App.xaml"/>
                                        </TreeViewItem>
                                    </TreeView>
                                </Grid>
                            </dock:LayoutAnchorable>
                            
                            <dock:LayoutAnchorable ContentId="output" Title="Output" CanHide="True" CanClose="False">
                                <Grid Background="LightCoral">
                                    <TextBox Margin="5" IsReadOnly="True" Background="Black" Foreground="White">
Build started...
Build succeeded.
Ready.
                                    </TextBox>
                                </Grid>
                            </dock:LayoutAnchorable>
                        </dock:LayoutAnchorablePane>
                        
                    </dock:LayoutPanel>
                    
                </dock:LayoutPanel>
            </dock:LayoutRoot>
            
        </dock:DockingManager>
        
    </Grid>
</Window>