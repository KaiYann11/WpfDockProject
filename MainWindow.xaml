<Window x:Class="WpfDockProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="http://schemas.xceed.com/wpf/xaml/avalondock"
        Title="WPF AvalonDock Example" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="View">
                <MenuItem Header="Toolbox" Click="ShowToolbox_Click"/>
                <MenuItem Header="Properties" Click="ShowProperties_Click"/>
                <MenuItem Header="Solution Explorer" Click="ShowSolutionExplorer_Click"/>
                <MenuItem Header="Output" Click="ShowOutput_Click"/>
            </MenuItem>
            <MenuItem Header="Window">
                <MenuItem Header="Reset Layout" Click="ResetLayout_Click"/>
            </MenuItem>
        </Menu>
        
        <!-- AvalonDock DockingManager -->
        <dock:DockingManager Grid.Row="1" Name="dockingManager">
            <dock:LayoutRoot>
                <dock:LayoutPanel Orientation="Horizontal">
                    
                    <!-- Left Side - Toolbox -->
                    <dock:LayoutAnchorablePaneGroup DockWidth="200" Orientation="Vertical">
                        <dock:LayoutAnchorablePane>
                            <dock:LayoutAnchorable ContentId="toolbox" Title="Toolbox" CanClose="True" CanFloat="True" CanAutoHide="True">
                                <Grid Background="LightBlue">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="도구상자" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <ListBox Background="White">
                                            <ListBoxItem>Button</ListBoxItem>
                                            <ListBoxItem>TextBox</ListBoxItem>
                                            <ListBoxItem>Label</ListBoxItem>
                                            <ListBoxItem>ComboBox</ListBoxItem>
                                            <ListBoxItem>CheckBox</ListBoxItem>
                                            <ListBoxItem>RadioButton</ListBoxItem>
                                            <ListBoxItem>DataGrid</ListBoxItem>
                                            <ListBoxItem>TreeView</ListBoxItem>
                                        </ListBox>
                                    </StackPanel>
                                </Grid>
                            </dock:LayoutAnchorable>
                        </dock:LayoutAnchorablePane>
                    </dock:LayoutAnchorablePaneGroup>
                    
                    <!-- Center Area -->
                    <dock:LayoutPanel Orientation="Vertical">
                        
                        <!-- Top Area - Solution Explorer -->
                        <dock:LayoutAnchorablePaneGroup DockHeight="150" Orientation="Horizontal">
                            <dock:LayoutAnchorablePane>
                                <dock:LayoutAnchorable ContentId="solution" Title="Solution Explorer" CanClose="True" CanFloat="True" CanAutoHide="True">
                                    <Grid Background="LightYellow">
                                        <TreeView Margin="5">
                                            <TreeViewItem Header="WpfDockProject" IsExpanded="True">
                                                <TreeViewItem Header="Properties"/>
                                                <TreeViewItem Header="References"/>
                                                <TreeViewItem Header="MainWindow.xaml"/>
                                                <TreeViewItem Header="App.xaml"/>
                                                <TreeViewItem Header="WpfDockProject.csproj"/>
                                            </TreeViewItem>
                                        </TreeView>
                                    </Grid>
                                </dock:LayoutAnchorable>
                            </dock:LayoutAnchorablePane>
                        </dock:LayoutAnchorablePaneGroup>
                        
                        <!-- Center Content Area - Documents -->
                        <dock:LayoutDocumentPaneGroup>
                            <dock:LayoutDocumentPane>
                                <dock:LayoutDocument ContentId="document1" Title="MainWindow.xaml">
                                    <Grid Background="White">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="AvalonDock 메인 편집 영역" FontSize="24" FontWeight="Bold" 
                                                      HorizontalAlignment="Center" Margin="0,0,0,20"/>
                                            <TextBlock Text="✓ 패널을 드래그하여 도킹 위치 변경" HorizontalAlignment="Center" Margin="0,5" Foreground="Green"/>
                                            <TextBlock Text="✓ 탭을 우클릭하여 플로팅/도킹 옵션" HorizontalAlignment="Center" Margin="0,5" Foreground="Green"/>
                                            <TextBlock Text="✓ 패널 헤더를 드래그하여 위치 재배치" HorizontalAlignment="Center" Margin="0,5" Foreground="Green"/>
                                            <TextBlock Text="✓ 자동 숨김 기능으로 공간 활용 최적화" HorizontalAlignment="Center" Margin="0,5" Foreground="Green"/>
                                            <TextBlock Text="✓ Visual Studio와 동일한 도킹 시스템" HorizontalAlignment="Center" Margin="0,5" Foreground="Blue" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>
                                </dock:LayoutDocument>
                                <dock:LayoutDocument ContentId="document2" Title="App.xaml">
                                    <Grid Background="WhiteSmoke">
                                        <TextBlock Text="App.xaml 파일 편집 영역" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                  FontSize="16" Foreground="Gray"/>
                                    </Grid>
                                </dock:LayoutDocument>
                            </dock:LayoutDocumentPane>
                        </dock:LayoutDocumentPaneGroup>
                        
                        <!-- Bottom Area - Output -->
                        <dock:LayoutAnchorablePaneGroup DockHeight="120" Orientation="Horizontal">
                            <dock:LayoutAnchorablePane>
                                <dock:LayoutAnchorable ContentId="output" Title="Output" CanClose="True" CanFloat="True" CanAutoHide="True">
                                    <Grid Background="LightCoral">
                                        <TextBox Margin="5" IsReadOnly="True" Background="Black" Foreground="White" 
                                                TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas">Build started...
Build succeeded.
Ready.

AvalonDock 기능 활성화됨:
- 드래그 앤 드롭 도킹 ✓
- 자동 도킹 인디케이터 ✓  
- 플로팅 윈도우 ✓
- 자동 숨김 (Auto Hide) ✓
- 탭 기반 문서 관리 ✓</TextBox>
                                    </Grid>
                                </dock:LayoutAnchorable>
                            </dock:LayoutAnchorablePane>
                        </dock:LayoutAnchorablePaneGroup>
                        
                    </dock:LayoutPanel>
                    
                    <!-- Right Side - Properties -->
                    <dock:LayoutAnchorablePaneGroup DockWidth="200" Orientation="Vertical">
                        <dock:LayoutAnchorablePane>
                            <dock:LayoutAnchorable ContentId="properties" Title="Properties" CanClose="True" CanFloat="True" CanAutoHide="True">
                                <Grid Background="LightGreen">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="속성" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <TextBlock Text="Name:" FontWeight="Bold"/>
                                        <TextBox Text="MainWindow" Margin="0,2,0,10"/>
                                        <TextBlock Text="Width:" FontWeight="Bold"/>
                                        <TextBox Text="800" Margin="0,2,0,10"/>
                                        <TextBlock Text="Height:" FontWeight="Bold"/>
                                        <TextBox Text="600" Margin="0,2,0,10"/>
                                        <TextBlock Text="Title:" FontWeight="Bold"/>
                                        <TextBox Text="WPF AvalonDock Example" Margin="0,2,0,10"/>
                                        <TextBlock Text="Background:" FontWeight="Bold"/>
                                        <ComboBox Margin="0,2,0,10">
                                            <ComboBoxItem>White</ComboBoxItem>
                                            <ComboBoxItem>LightGray</ComboBoxItem>
                                            <ComboBoxItem>Transparent</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </dock:LayoutAnchorable>
                        </dock:LayoutAnchorablePane>
                    </dock:LayoutAnchorablePaneGroup>
                    
                </dock:LayoutPanel>
            </dock:LayoutRoot>
        </dock:DockingManager>
    </Grid>
</Window>