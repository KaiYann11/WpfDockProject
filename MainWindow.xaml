<Window x:Class="WpfDockProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF Dock/Undock Example" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="Controls">
                <MenuItem Name="ToolboxMenuItem" Header="Toolbox" IsCheckable="True" IsChecked="True" 
                         Click="ToggleDockableControl_Click"/>
                <MenuItem Name="PropertiesMenuItem" Header="Properties" IsCheckable="True" IsChecked="True" 
                         Click="ToggleDockableControl_Click"/>
                <MenuItem Name="SolutionMenuItem" Header="Solution Explorer" IsCheckable="True" IsChecked="True" 
                         Click="ToggleDockableControl_Click"/>
                <MenuItem Name="OutputMenuItem" Header="Output" IsCheckable="True" IsChecked="True" 
                         Click="ToggleDockableControl_Click"/>
            </MenuItem>
        </Menu>
        
        <!-- Main Grid with Resizable Layout -->
        <Grid Grid.Row="1" Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="150" MinHeight="100"/>  <!-- Top Panel -->
                <RowDefinition Height="5"/>                    <!-- Top Splitter -->
                <RowDefinition Height="*"/>                    <!-- Middle Row -->
                <RowDefinition Height="5"/>                    <!-- Bottom Splitter -->
                <RowDefinition Height="100" MinHeight="50"/>   <!-- Bottom Panel -->
            </Grid.RowDefinitions>
            
            <!-- Top Panel - Solution Explorer -->
            <Border Name="SolutionPanel" Grid.Row="0" Background="LightYellow" 
                    BorderBrush="Gray" BorderThickness="1" Margin="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="Orange" Padding="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Solution Explorer" Foreground="White" FontWeight="Bold"/>
                            <Button Name="UndockSolutionBtn" Content="📌" Width="20" Height="20" 
                                   Margin="5,0,0,0" Click="UndockControl_Click" Tag="Solution"/>
                        </StackPanel>
                    </Border>
                    <TreeView Grid.Row="1" Margin="5">
                        <TreeViewItem Header="WpfDockProject" IsExpanded="True">
                            <TreeViewItem Header="Properties"/>
                            <TreeViewItem Header="References"/>
                            <TreeViewItem Header="MainWindow.xaml"/>
                            <TreeViewItem Header="App.xaml"/>
                        </TreeViewItem>
                    </TreeView>
                </Grid>
            </Border>
            
            <!-- Horizontal Splitter for Top -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" 
                         Background="DarkGray" ResizeBehavior="PreviousAndNext"/>
            
            <!-- Middle Row with Left, Center, Right -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" MinWidth="100"/>  <!-- Left Panel -->
                    <ColumnDefinition Width="5"/>                   <!-- Left Splitter -->
                    <ColumnDefinition Width="*"/>                   <!-- Center Content -->
                    <ColumnDefinition Width="5"/>                   <!-- Right Splitter -->
                    <ColumnDefinition Width="200" MinWidth="100"/>  <!-- Right Panel -->
                </Grid.ColumnDefinitions>
                
                <!-- Left Panel - Toolbox -->
                <Border Name="ToolboxPanel" Grid.Column="0" Background="LightBlue" 
                        BorderBrush="Gray" BorderThickness="1" Margin="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="DarkBlue" Padding="5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Toolbox" Foreground="White" FontWeight="Bold"/>
                                <Button Name="UndockToolboxBtn" Content="📌" Width="20" Height="20" 
                                       Margin="5,0,0,0" Click="UndockControl_Click" Tag="Toolbox"/>
                            </StackPanel>
                        </Border>
                        <ListBox Grid.Row="1" Margin="5">
                            <ListBoxItem>Button</ListBoxItem>
                            <ListBoxItem>TextBox</ListBoxItem>
                            <ListBoxItem>Label</ListBoxItem>
                            <ListBoxItem>ComboBox</ListBoxItem>
                            <ListBoxItem>CheckBox</ListBoxItem>
                        </ListBox>
                    </Grid>
                </Border>
                
                <!-- Vertical Splitter for Left -->
                <GridSplitter Grid.Column="1" Width="5" VerticalAlignment="Stretch" 
                             Background="DarkGray" ResizeBehavior="PreviousAndNext"/>
                
                <!-- Center Content Area -->
                <Border Grid.Column="2" Background="White" BorderBrush="Gray" BorderThickness="1" Margin="2">
                    <Grid>
                        <TextBlock Text="Main Content Area" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                  FontSize="24" FontWeight="Bold" Foreground="Gray"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20">
                            <TextBlock Text="Dock/Undock 기능:" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="• 각 패널의 📌 버튼을 클릭하면 별도 창으로 분리됩니다" Margin="0,2"/>
                            <TextBlock Text="• 메뉴에서 패널을 체크/해제하여 표시/숨김 할 수 있습니다" Margin="0,2"/>
                            <TextBlock Text="• 분리된 창을 닫으면 다시 원래 위치로 도킹됩니다" Margin="0,2"/>
                            <TextBlock Text="• GridSplitter로 패널 크기를 조절할 수 있습니다" Margin="0,2" Foreground="Red" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Vertical Splitter for Right -->
                <GridSplitter Grid.Column="3" Width="5" VerticalAlignment="Stretch" 
                             Background="DarkGray" ResizeBehavior="PreviousAndNext"/>
                
                <!-- Right Panel - Properties -->
                <Border Name="PropertiesPanel" Grid.Column="4" Background="LightGreen" 
                        BorderBrush="Gray" BorderThickness="1" Margin="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="DarkGreen" Padding="5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Properties" Foreground="White" FontWeight="Bold"/>
                                <Button Name="UndockPropertiesBtn" Content="📌" Width="20" Height="20" 
                                       Margin="5,0,0,0" Click="UndockControl_Click" Tag="Properties"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="5">
                            <TextBlock Text="Name:" FontWeight="Bold"/>
                            <TextBox Text="Control1" Margin="0,2,0,5"/>
                            <TextBlock Text="Width:" FontWeight="Bold"/>
                            <TextBox Text="200" Margin="0,2,0,5"/>
                            <TextBlock Text="Height:" FontWeight="Bold"/>
                            <TextBox Text="100" Margin="0,2,0,5"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            
            <!-- Horizontal Splitter for Bottom -->
            <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" 
                         Background="DarkGray" ResizeBehavior="PreviousAndNext"/>
            
            <!-- Bottom Panel - Output -->
            <Border Name="OutputPanel" Grid.Row="4" Background="LightCoral" 
                    BorderBrush="Gray" BorderThickness="1" Margin="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="DarkRed" Padding="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Output" Foreground="White" FontWeight="Bold"/>
                            <Button Name="UndockOutputBtn" Content="📌" Width="20" Height="20" 
                                   Margin="5,0,0,0" Click="UndockControl_Click" Tag="Output"/>
                        </StackPanel>
                    </Border>
                    <TextBox Grid.Row="1" Margin="5" IsReadOnly="True" Background="Black" Foreground="White">
Build started...
Build succeeded.
Ready.
                    </TextBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>