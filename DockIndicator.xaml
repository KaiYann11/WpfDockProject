<UserControl x:Class="WpfDockProject.DockIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="60" Height="60" IsHitTestVisible="False">
    <Grid>
        <Ellipse Fill="#AA007ACC" Stroke="#007ACC" StrokeThickness="3" Width="50" Height="50"/>
        <Polygon Points="20,30 30,20 40,30 30,40" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>