<Window x:Class="WpfDockProject.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floating Panel" Height="300" Width="400"
        WindowStyle="None" ShowInTaskbar="False"
        ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent">
    <Border BorderBrush="Gray" BorderThickness="2" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Custom Title Bar (Draggable) -->
            <Border Grid.Row="0" Name="TitleBar" Background="DarkGray" Padding="5"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseDoubleClick="TitleBar_MouseDoubleClick">
                <Grid>
                    <TextBlock Name="TitleText" Text="Floating Panel" Foreground="White" 
                              FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Name="PinButton" Content="📌" Width="20" Height="20" 
                           HorizontalAlignment="Right" Click="PinButton_Click"
                           ToolTip="Dock this panel back"/>
                </Grid>
            </Border>
            
            <!-- Content Area -->
            <Border Grid.Row="1" Name="ContentBorder" BorderBrush="Transparent" BorderThickness="0">
                <!-- Content will be set programmatically -->
            </Border>
        </Grid>
    </Border>
</Window>