<Window x:Class="WpfDockProject.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floating Panel" Height="300" Width="400"
        WindowStyle="ToolWindow" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar with Pin Button -->
        <Border Grid.Row="0" Background="DarkGray" Padding="5">
            <Grid>
                <TextBlock Name="TitleText" Text="Floating Panel" Foreground="White" 
                          FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Name="PinButton" Content="📌" Width="20" Height="20" 
                       HorizontalAlignment="Right" Click="PinButton_Click"
                       ToolTip="Dock this panel back"/>
            </Grid>
        </Border>
        
        <!-- Content Area -->
        <Border Grid.Row="1" Name="ContentBorder" BorderBrush="Gray" BorderThickness="1">
            <!-- Content will be set programmatically -->
        </Border>
    </Grid>
</Window>